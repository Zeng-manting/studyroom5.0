<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 2.7.18（2.x 最终版），JDK 11 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.studyroom</groupId>
    <artifactId>studyroom-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>studyroom-parent</name>
    <description>基于 Spring Boot 的无人自习室管理系统 - 父工程（三层架构，业务逻辑统一由 Spring Boot 处理）</description>

    <!-- 多模块划分：common(公共) -> entity(实体) -> mapper(持久层) -> service(业务层) -> web(接口层) -->
    <modules>
        <module>studyroom-common</module>
        <module>studyroom-entity</module>
        <module>studyroom-mapper</module>
        <module>studyroom-service</module>
        <module>studyroom-web</module>
    </modules>

    <properties>
        <!-- 编译环境：JDK 11 -->
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 依赖版本统一管理（严格遵循《技术选型与功能汇总.md》1.3 节） -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <redisson.version>3.23.4</redisson.version>
        <jjwt.version>0.11.5</jjwt.version>
        <knife4j.version>4.3.0</knife4j.version>
        <swagger-annotations.version>1.6.11</swagger-annotations.version>
        <hutool.version>5.8.25</hutool.version>
        <fastjson2.version>2.0.42</fastjson2.version>
        <weixin-java.version>4.5.0</weixin-java.version>
        <easyexcel.version>3.3.3</easyexcel.version>
        <druid.version>1.2.18</druid.version>
        <qcloud-cos.version>1.9.30</qcloud-cos.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== 内部模块 ==================== -->
            <dependency>
                <groupId>com.studyroom</groupId>
                <artifactId>studyroom-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.studyroom</groupId>
                <artifactId>studyroom-entity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.studyroom</groupId>
                <artifactId>studyroom-mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.studyroom</groupId>
                <artifactId>studyroom-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==================== ORM：MyBatis-Plus 3.5.5 ==================== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- mybatis-plus-core：IPage 分页对象（common 模块 PageResult 依赖） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ==================== Redis 分布式客户端：Redisson 3.23.4 ==================== -->
            <!-- 用于座位原子锁座(FR-UC-018)、接口限流(FR-SY-001)、延迟队列(FR-SY-002) -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ==================== JWT：jjwt 0.11.5（HMAC-SHA256） ==================== -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ==================== 接口文档：Knife4j 4.3.0（适配 Spring Boot 2.x） ==================== -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi2-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <!-- Swagger 注解（供 entity/mapper/service 子模块的 DTO/VO 使用，与 Knife4j 注解体系一致） -->
            <dependency>
                <groupId>io.swagger</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>

            <!-- ==================== 工具库 ==================== -->
            <!-- Hutool 5.8.x：加密(AES/HMAC)、日期、CaptchaUtil 图形验证码(FR-AD-001) -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- Fastjson2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <!-- WxJava 4.5.0：微信小程序 API 封装（FR-UC-001 静默登录、订阅消息） -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-miniapp</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>
            <!-- EasyExcel 3.3.x：订单导出(FR-AD-013)、报表导出(FR-AD-023/024) -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <!-- Druid 1.2.18：连接池 + SQL 监控 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <!-- 腾讯云 COS 1.9.30：对象存储（当前本地存储替代，FR-CC-003 预留） -->
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${qcloud-cos.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- 只在 studyroom-web 打可执行 jar -->
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
